#!/usr/bin/env bash
# learn — one-command entry to the AI learning system.
# Usage: ./learn [pi args...]  (e.g. ./learn "Teach me how power grids work")
set -euo pipefail
cd "$(dirname "$0")"
if ! command -v pi >/dev/null 2>&1; then
  echo "pi not found. Install first:"
  echo "  curl -fsSL https://pi.dev/install.sh | sh   # pinned (recommended)"
  echo "  # or: npm install -g --ignore-scripts @earendil-works/pi-coding-agent"
  echo "Then run: pi --help, and /login inside pi for provider."
  exit 1
fi
exec pi "$@"
